# Cloud FinOps Agent Environment Configuration
# Copy this file to .env and adjust variables as needed

# Environment
APP_ENV=development
LOG_LEVEL=INFO

# Server
PORT=8000
HOST=0.0.0.0

# Database (Default: local SQLite database, or set PostgreSQL URL)
DATABASE_URL=sqlite:///./finops_audit.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloud_finops

# Gemini LLM API Key (Optional: if empty, deterministic fallback mode is active)
GEMINI_API_KEY=

# Terraform Configuration
TERRAFORM_BINARY_PATH=terraform
TERRAFORM_DIR=./terraform

# Safety & Remediation Controls
DRY_RUN_ONLY=true
REQUIRE_HUMAN_APPROVAL=true
MAX_CORRECTION_RETRIES=3
