# Terraform Configuration Generated by Cloud FinOps Agent
# Optimization Proposal: eval-SCEN-05
# Action: Configure S3 Lifecycle Archive Tiering

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

resource "aws_s3_bucket_lifecycle_configuration" "eval_dev_archive_bucket_lifecycle" {
  bucket = "s3-eval-05-dev-bucket"

  rule {
    id     = "archive-infrequent-data"
    status = "Enabled"

    transition {
      days          = 30
      storage_class = "GLACIER_IR"
    }

    noncurrent_version_expiration {
      noncurrent_days = 90
    }
  }
}
